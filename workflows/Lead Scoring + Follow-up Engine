      "parameters": {
        "jsCode": "const fields = $json.body.data.fields;\nconst result = {};\n\nfields.forEach(f => {\n  const cleanKey = f.label.toLowerCase().replace(/\\s+/g, '_');\n  \n  // Kung may options array (dropdown/multiple choice), i-map yung ID papunta sa actual text\n  if (f.options && Array.isArray(f.options)) {\n    const selectedIds = Array.isArray(f.value) ? f.value : [f.value];\n    const selectedLabels = selectedIds.map(id => {\n      const match = f.options.find(opt => opt.id === id);\n      return match ? match.text : id;\n    });\n    result[cleanKey] = selectedLabels.join(', ');\n  } else {\n    result[cleanKey] = f.value;\n  }\n});\n\nreturn [{ json: result }];"
      },
