          "jsCode": "const data = $('Get Info').item.json;\nlet score = 0;\n\nconst budgetScores = {\n  \"$5k+\": 40,\n  \"$2k-5k\": 30,\n  \"$500-2k\": 15,\n  \"<$500\": 5\n};\nscore += budgetScores[data.budget_range] || 0;\n\nconst timelineScores = {\n  \"ASAP\": 35,\n  \"1 month\": 25,\n  \"2-3 months\": 15,\n  \"just exploring\": 5\n};\nscore += timelineScores[data.timeline] || 0;\n\nif (data.company_size >= 10) score += 25;\nelse if (data.company_size >= 5) score += 15;\nelse score += 5;\n\nscore = Math.min(score, 100);\n\nlet tier;\nif (score >= 80) tier = \"HOT\";\nelse if (score >= 50) tier = \"WARM\";\nelse tier = \"COLD\";\n\nreturn [{\n  json: {\n    ...data,\n    lead_score: score,\n    lead_tier: tier\n  }\n}];"
